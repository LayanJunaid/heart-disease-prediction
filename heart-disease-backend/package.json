{
  "name": "heart-disease-backend",
  "version": "1.0.0",
  "description": "REST API backend for Heart Disease Prediction using ML — Node.js / Express / MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "train-model": "python3 ml/train.py",
    "lint": "eslint src/ --ext .js",
    "test": "NODE_ENV=test jest --forceExit --detectOpenHandles"
  },
  "keywords": [
    "heart-disease",
    "machine-learning",
    "express",
    "mongodb",
    "rest-api"
  ],
  "author": "Heart Disease Prediction Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.1.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "joblib": "^10.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^9.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
